; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Stock Market Academy"
config/description="Bilingual financial education and trading simulation with an event-driven story layer."
config/version="beta-22"
run/main_scene="res://ui/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.0352941, 0.0666667, 0.12549, 1)
boot_splash/image="res://assets/icon.png"
boot_splash/fullsize=false
boot_splash/use_filter=false
config/icon="res://assets/icon.png"

[autoload]

I18n="*res://app/i18n.gd"
Sfx="*res://app/audio.gd"
Game="*res://app/game.gd"

[audio]

general/default_playback_type.web=0

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/default_font_multichannel_signed_distance_field=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
